# Copy to .env to override defaults. Record Merge needs no secrets to run.

# Port the HTTP server listens on.
PORT=4100

# Public base URL. Session cookies are marked secure when it starts with https.
PUBLIC_URL=http://localhost:4100

# Where the embedded Postgres keeps its files. Use "memory" for a throwaway database.
DATA_DIR=.data/pglite

# Seed fictional demo data when the database is empty (true or false).
SEED_DEMO=true

# Hours until a sign-in session expires.
SESSION_TTL_HOURS=12

# Log level: debug, info, warn or error.
LOG_LEVEL=info
